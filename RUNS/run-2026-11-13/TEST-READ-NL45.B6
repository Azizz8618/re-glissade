*name Tstread
*call yesmemory
*forex
C     МИНИМАЛЬНЫЙ ТЕСТ ВВОДА ДАННЫХ (БЛОК А2).  ПРОГРАММА НЕ ДЕЛАЕТ
C     НИЧЕГО, КРОМЕ ДВУХ READ(5) И ЭХО-ПЕЧАТИ ПРОЧИТАННОГО НА АЦПУ.
      DIMENSION IA(5)
      REAL B(4)
C     КАРТА 1 (5I5): ТА ЖЕ, ЧТО У ГЛИССАДЫ
      READ(5,100) IA(1),IA(2),IA(3),IA(4),IA(5)
  100 FORMAT(5I5)
C     КАРТА 2 (4F8.0)
      READ(5,101) B(1),B(2),B(3),B(4)
  101 FORMAT(4F8.0)
      WRITE(6,102) IA(1),IA(2),IA(3),IA(4),IA(5)
  102 FORMAT(1H ,5HIA = ,5I6)
      WRITE(6,103) B(1),B(2),B(3),B(4)
  103 FORMAT(1H ,5HB =  ,4F9.2)
      WRITE(6,104)
  104 FORMAT(1H ,7HREAD OK)
      STOP
      END
*execute
    3    1    0    5    1
   2400.   7351.     1.5     .60
*end file
