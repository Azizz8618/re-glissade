C==============================================================
C     ГЛИССАДА-6. РЕЗЕРВНЫЙ КОНТРОЛЬ ТОЧНОСТИ ПО КУТТА-МЕРСОНУ.
C     ВМЕСТО ПОДПРОГРАММЫ СТАНДАРТНОЙ БИБЛИОТЕКИ АД01.
C     ВОЗВРАЩАЕТ ОЦЕНКУ ЛОКАЛЬНОЙ ПОГРЕШНОСТИ НА ОДНОМ ШАГЕ
C     ДЛЯ ВЕКТОРА СОСТОЯНИЯ X(13) ПРИ УПРАВЛЕНИИ U(4).
C     САМО СОСТОЯНИЕ НЕ ИЗМЕНЯЕТСЯ.
C==============================================================
      SUBROUTINE KUTMER(X,U,DT,ERR)
      DIMENSION X(13),U(4)
      DIMENSION K1(13),K2(13),K3(13),K4(13),K5(13),K6(13)
      DIMENSION XA(13)
      COMMON /GLOB/ T,DTSHAG,KTIP,MODE,ICTRL,NFR,IFLIB,TMAX
      H=DT
      CALL PROIZV(X,U,K1)
      DO 10 I=1,13
   10 XA(I)=X(I)+H*K1(I)/3.
      CALL PROIZV(XA,U,K2)
      DO 20 I=1,13
   20 XA(I)=X(I)+H*(K1(I)+K2(I))/6.
      CALL PROIZV(XA,U,K3)
      DO 30 I=1,13
   30 XA(I)=X(I)+H*(K1(I)+3.*K3(I))/8.
      CALL PROIZV(XA,U,K4)
      DO 40 I=1,13
   40 XA(I)=X(I)+H*(K1(I)-3.*K3(I)+4.*K4(I))/2.
      CALL PROIZV(XA,U,K5)
      DO 50 I=1,13
   50 XA(I)=X(I)+H*(K1(I)+4.*K4(I)+K5(I))/6.
      CALL PROIZV(XA,U,K6)
C     ОЦЕНКА МЕРСОНА: |2K1-9K3+8K4-K5|/30
      ERR=0.
      DO 60 I=1,13
      E=ABS((2.*K1(I)-9.*K3(I)+8.*K4(I)-K5(I))/30.)
      IF(E.GT.ERR) ERR=E
   60 CONTINUE
      RETURN
      END
