C==============================================================
C     ГЛИССАДА-6. КАДР АЦПУ, ВЫВОД НА ДИСПЛЕЙ, ОЦЕНКА ПОСАДКИ.
C     ПЕРВАЯ ПОЗИЦИЯ СТРОКИ - УПРАВЛЕНИЕ КАРАЖКОМ АЦПУ.
C==============================================================
      SUBROUTINE FRAME(X,U)
      DIMENSION X(13),U(4),LINE(41)
      COMMON /GLOB/ T,DTSHAG,KTIP,MODE,ICTRL,NFR,IFLIB,TMAX
      COMMON /VYVOD/ ALFA,BETA,QBAR,VA,RHO,THR,CLV,CDV
      DATA NBLANK/1H /,NSTAR/1H*/
C     ЭЙЛЕРОВЫ УГЛЫ ИЗ КВАТЕРНИОНА (ТАНГЕНСЫ ПОЛУ-УГЛОВ)
      Q0=X(4)
      A11=Q0*Q0+X(5)*X(5)-X(6)*X(6)-X(7)*X(7)
      A21=2.*(X(5)*X(6)+Q0*X(7))
      A31=2.*(X(5)*X(7)-Q0*X(6))
      A22=Q0*Q0-X(5)*X(5)+X(6)*X(6)-X(7)*X(7)
      A32=2.*(X(6)*X(7)+Q0*X(5))
      ST=A21
      IF(ABS(ST).GT.0.999) ST=SIGN(0.999,ST)
      THETA=ATAN(ST/SQRT(1.-ST*ST))*57.2958
      PSI=ATAN2(-A31,A11)*57.2958
      GAM=ATAN2(A32,A22)*57.2958
      DTM=-X(11)
      EGLI=X(13)+0.05241*X(11)
      IPOS=21+IFIX(EGLI/5.)
      IF(IPOS.LT.1) IPOS=1
      IF(IPOS.GT.41) IPOS=41
      DO 10 I=1,41
   10 LINE(I)=NBLANK
      LINE(IPOS)=NSTAR
      WRITE(6,700) T,DTM,X(13)
  700 FORMAT(1H0,8HGLISSADA,2X,2HT=,F7.1,2H S,7H DALN=,F7.0,
     16H  VYS=,F8.1)
      WRITE(6,701) VA,X(2),ALFA,100.*U(4)
  701 FORMAT(1H ,5HSKOR=,F6.1,4H M/S,6H VERT=,F7.2,4H M/S,
     17H ATAKA=,F5.1,3H GR,6H TYAG=,F4.0,4H PRC)
      WRITE(6,702) U(1)*57.2958,U(2)*57.2958,U(3)*57.2958,THETA,GAM,
     1PSI
  702 FORMAT(1H ,3HRV=,F6.1,3H GR,3HEL=,F6.1,3H GR,3HRN=,F6.1,
     13H GR,5HTANG=,F6.1,3H GR,5HKREN=,F6.1,3H GR,5HKURS=,F6.1,
     23H GR)
      WRITE(6,703)
  703 FORMAT(1H ,17X,14HGLISSADA 3 GR.)
      WRITE(6,704) (LINE(I),I=1,41)
  704 FORMAT(1H ,17X,41A1)
      WRITE(6,705) X(12),EGLI
  705 FORMAT(1H ,9HKURS LUCH,4H  Y=,F7.1,2H M,7H  GLIS=,F7.1,2H M,/)
      RETURN
      END
C     КОРОТКАЯ СТРОКА НА ДИСПЛЕЙ (КАНАЛ 12)
      SUBROUTINE DISPL(X)
      DIMENSION X(13)
      COMMON /GLOB/ T,DTSHAG,KTIP,MODE,ICTRL,NFR,IFLIB,TMAX
      WRITE(12,710) T,X(13),X(2),-X(11)
  710 FORMAT(3HDSP,3H T=,F7.1,4H VYS,F7.1,5H VERT,F7.2,
     15H DALN,F7.0)
      RETURN
      END
C     ОЦЕНКА ПОСАДКИ ПО ВЕРТИКАЛЬНОЙ СКОРОСТИ И ТОЧКЕ КАСАНИЯ
      SUBROUTINE JUDG(X)
      DIMENSION X(13)
      COMMON /GLOB/ T,DTSHAG,KTIP,MODE,ICTRL,NFR,IFLIB,TMAX
      COMMON /SCHET/ SUME,NEGL
      VY=X(2)
      DTK=X(11)
      AVY=ABS(VY)
      K=4
      IF(AVY.LE.4.0) K=3
      IF(AVY.LE.2.5) K=2
      IF(AVY.LE.1.5) K=1
      SKO=0.
      IF(NEGL.GT.0) SKO=SQRT(SUME/FLOAT(NEGL))
      WRITE(6,800)
  800 FORMAT(1H1,30X,14HOCENKA POSADKI,//)
      WRITE(6,801) VY
  801 FORMAT(1H0,20HVERT. SKOROST KASAN.,F6.2,4H M/S)
      WRITE(6,802) DTK
  802 FORMAT(1H ,24HTOCHKA KASANIYA OT POROGA,F7.0,2H M)
      WRITE(6,803) X(12)
  803 FORMAT(1H ,17HSMESHCHENIE OT OSI,F7.1,2H M)
      WRITE(6,804) SKO
  804 FORMAT(1H ,15HSKO OT GLISSADY,F7.2,2H M)
      GO TO (10,20,30,40),K
   10 WRITE(6,810)
  810 FORMAT(1H0,8HOTLICHNO)
      GO TO 50
   20 WRITE(6,820)
  820 FORMAT(1H0,7HHOROSHO)
      GO TO 50
   30 WRITE(6,830)
  830 FORMAT(1H0,16HUDOVLETVORITELNO)
      GO TO 50
   40 WRITE(6,840)
  840 FORMAT(1H0,17HZHESTKAYA POSADKA)
   50 CONTINUE
      WRITE(6,850) K
  850 FORMAT(1H0,7HOCENKA=,I2)
      IF(X(11).LT.0.) WRITE(6,860)
  860 FORMAT(1H0,25HAVARIA: KASANIE DO POROGA)
      WRITE(6,870) T
  870 FORMAT(1H0,2HT=,F7.1,7H SEKUND)
      RETURN
      END
