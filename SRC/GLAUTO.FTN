C==============================================================
C     ГЛИССАДА-6. АВТОПИЛАТ ЗАХОДА (РЕЖИМ 1).
C     УСИЛЕНИЯ ВЫБИРАЮТСЯ ПО SIGW ИЗ БЛОКА /APGAIN/ (GLGAIN.FTN),
C     КОТОРЫЙ ГЕНЕРИРУЕТСЯ ИЗ TOOLS/CALIB/LEVELS/*.JSON.
C     OFF/HFL/VYF - КОНСТАНТЫ ТИПА, ВЗЯТЫ ИЗ TOOLS/CALIB/BEST.JSON.
C==============================================================
      SUBROUTINE GLAUTO(X,U)
      DIMENSION X(13),U(4)
      COMMON /SOST/ GM,S,BB,CC,CL0,CLA,CLMX,CD0,AK,CMA,CM0,CMDE,
     1CMQ,CLB,CLDA,CLP,CNB,CNDR,CNR,CYB,ETYPE,THMAX,PMAX,VTHR,HCR
      COMMON /VYVOD/ ALFA,BETA,QBAR,VA,RHO,THR,CLV,CDV
      COMMON /GLOB/ T,DTSHAG,KTIP,MODE,ICTRL,NFR,IFLIB,TMAX
      COMMON /BURJA/ WGX,WGY,WGZ,SIGW,TAU
      COMMON /APGAIN/ PGE(5,5),PKV(5,5),PKD(5,5),CG(5,5),SLVL(5)
C     БЛИЖАЙШИЙ УРОВЕНЬ ТУРБУЛЕНТНОСТИ
      L=1
      D=ABS(SIGW-SLVL(1))
      DO 10 J=2,5
      IF(ABS(SIGW-SLVL(J)).GE.D) GO TO 10
      L=J
      D=ABS(SIGW-SLVL(J))
   10 CONTINUE
      GE=PGE(L,KTIP)
      EKV=PKV(L,KTIP)
      EKD=PKD(L,KTIP)
      EGLI=X(13)+0.05241*X(11)
      GO TO (100,200,300,400,500),KTIP
  100 CONTINUE
      VYC=-0.05241*X(1)-GE*EGLI
      IF(X(13).LT.HCR+(32)) VYC=(-0.6061)
      DE=(-EKV)*(X(2)-VYC)-EKD*X(10)
      GO TO 150
  200 CONTINUE
      EGLI=EGLI+(-18)
      VYC=-0.05241*X(1)-GE*EGLI
      IF(X(13).LT.HCR+(61)) VYC=(-0.4807)
      DE=(-EKV)*(X(2)-VYC)-EKD*X(10)
      GO TO 150
  300 CONTINUE
      VYC=-0.05241*X(1)-GE*EGLI
      IF(X(13).LT.HCR+(20)) VYC=(-0.4)
      DE=(-EKV)*(X(2)-VYC)-EKD*X(10)
      GO TO 150
  400 CONTINUE
      EGLI=EGLI+(-20)
      VYC=-0.05241*X(1)-GE*EGLI
      IF(X(13).LT.HCR+(170)) VYC=(-0.415)
      DE=(-EKV)*(X(2)-VYC)-EKD*X(10)
      GO TO 150
  500 CONTINUE
      EGLI=EGLI+(-30)
      VYC=-0.05241*X(1)-GE*EGLI
      IF(X(13).LT.HCR+(3)) VYC=(-0.2923)
      DE=(-EKV)*(X(2)-VYC)-EKD*X(10)
      GO TO 150
  150 CONTINUE
      IF(DE.GT.0.30) DE=0.30
      IF(DE.LT.-0.30) DE=-0.30
      U(1)=DE
      DTZ=0.35+2.0*(VTHR-X(1))/VTHR
      IF(DTZ.GT.1.) DTZ=1.
      IF(DTZ.LT.0.) DTZ=0.
      U(4)=DTZ
      DA=-0.0008*X(12)-0.02*X(3)-0.25*X(8)
      IF(DA.GT.0.15) DA=0.15
      IF(DA.LT.-0.15) DA=-0.15
      U(2)=DA
      DR=-1.0*X(9)+0.03*BETA
      IF(DR.GT.0.20) DR=0.20
      IF(DR.LT.-0.20) DR=-0.20
      U(3)=DR
      RETURN
      END
C     ПРОГРАММА ПИЛОТИРОВАНИЯ: ЛИНЕЙНАЯ ИНТЕРПОЛЯЦИЯ ПО КАРТАМ
      SUBROUTINE PROGC(T,U)
      DIMENSION U(4)
      COMMON /PROGT/ TT(100),DEA(100),DAA(100),DRA(100),DTA(100),NTAB
      IF(NTAB.LE.0) RETURN
      IF(NTAB.EQ.1) GO TO 50
      IF(T.GE.TT(NTAB)) GO TO 50
      K=1
      DO 10 I=2,NTAB
      IF(T.LT.TT(I)) GO TO 20
   10 K=I
      GO TO 50
   20 F=(T-TT(K))/(TT(K+1)-TT(K))
      U(1)=(DEA(K)+(DEA(K+1)-DEA(K))*F)*0.017453
      U(2)=(DAA(K)+(DAA(K+1)-DAA(K))*F)*0.017453
      U(3)=(DRA(K)+(DRA(K+1)-DRA(K))*F)*0.017453
      U(4)=DTA(K)+(DTA(K+1)-DTA(K))*F
      RETURN
   50 U(1)=DEA(NTAB)*0.017453
      U(2)=DAA(NTAB)*0.017453
      U(3)=DRA(NTAB)*0.017453
      U(4)=DTA(NTAB)
      RETURN
      END
C     ВВОД ПРОГРАММЫ ПИЛОТИРОВАНИЯ С КАРТ (ДО КАРТЫ С Т<0)
      SUBROUTINE PRVIN
      COMMON /PROGT/ TT(100),DEA(100),DAA(100),DRA(100),DTA(100),NTAB
      NTAB=0
      DO 10 I=1,100
      READ(5,950) TT(I),DEA(I),DAA(I),DRA(I),DTA(I)
  950 FORMAT(5F8.0)
      IF(TT(I).LT.0.) GO TO 20
      NTAB=I
   10 CONTINUE
   20 RETURN
      END
